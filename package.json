{
  "name": "prehistoric-wilds",
  "private": true,
  "version": "1.0.0",
  "description": "Prehistoric Wilds — a stylized 3D browser hunting, gathering, and crafting expedition",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:docs": "node scripts/sync-readme.mjs",
    "sync:check": "node scripts/sync-readme.mjs --check",
    "build": "node scripts/sync-readme.mjs && tsc --noEmit && vite build && node scripts/check-size.mjs",
    "build:pages": "node scripts/sync-readme.mjs && tsc --noEmit && vite build",
    "build:share": "node scripts/manus-game-assets/restore.mjs && node scripts/manus-game-sharing/build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "manus:build-source": "tsc --noEmit && vite build && node scripts/check-size.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^22.20.4",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  },
  "packageManager": "pnpm@10.18.0"
}
